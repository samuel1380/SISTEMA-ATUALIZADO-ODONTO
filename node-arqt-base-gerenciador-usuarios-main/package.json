{
  "name": "@hunter-solucoes/node-arqt-base-gerenciador-usuarios",
  "version": "1.0.37",
  "private": false,
  "main": "./dist",
  "scripts": {
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "rimraf dist && nest build",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --testPathIgnorePatterns",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.3.0",
    "@aws-sdk/node-http-handler": "^3.3.0",
    "@aws-sdk/types": "^3.3.0",
    "@hunter-solucoes/node-arqt-base-gerenciador-financeiro": "^1.0.7",
    "@nestjs/cli": "^7.5.4",
    "@nestjs/common": "^7.6.4",
    "@nestjs/core": "^7.6.4",
    "@nestjs/jwt": "^7.2.0",
    "@nestjs/passport": "^7.1.5",
    "@nestjs/platform-express": "^7.6.4",
    "@nestjs/swagger": "^4.7.9",
    "@nestjs/typeorm": "^7.1.5",
    "axios": "^0.20.0",
    "body-parser": "^1.19.0",
    "class-transformer": "^0.2.3",
    "class-validator": "^0.12.2",
    "dotenv": "^8.2.0",
    "generate-password": "^1.7.0",
    "helmet": "^4.5.0",
    "jsonwebtoken": "^8.5.1",
    "module-alias": "^2.2.2",
    "multer": "^1.4.2",
    "mysql": "^2.18.1",
    "nodemailer": "^6.5.0",
    "passport": "^0.2.2",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^6.6.3",
    "swagger-ui-express": "4.1.4",
    "ts-node": "^10.7.0",
    "typeorm": "^0.2.29",
    "typeorm-transactional-cls-hooked": "^0.1.20"
  },
  "devDependencies": {
    "@nestjs/schematics": "^7.2.6",
    "@nestjs/testing": "^7.6.4",
    "@types/express": "^4.17.9",
    "@types/jest": "25.1.4",
    "@types/multer": "^1.4.5",
    "@types/node": "^13.13.38",
    "@types/nodemailer": "^6.4.1",
    "@types/passport-jwt": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^2.23.0",
    "@typescript-eslint/parser": "^2.23.0",
    "aws-sdk": "^2.868.0",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-import": "^2.22.1",
    "jest": "26.6.3",
    "prettier": "^1.19.1",
    "ts-jest": "^26.4.4",
    "ts-loader": "^6.2.1",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^4.6.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)": "<rootDir>/$1"
    },
    "coveragePathIgnorePatterns": [
      ".schema.ts"
    ],
    "setupFiles": [
      "../jest-setup-file.ts"
    ]
  },
  "repository": "https://github.com/hunter-solucoes/test.git",
  "_moduleAliases": {
    "@src": "dist/src"
  }
}
