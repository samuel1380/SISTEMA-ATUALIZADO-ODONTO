    "class-validator": "^0.12.2",
    "dotenv": "^8.6.0",
    "helmet": "^4.5.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.2",
    "mysql2": "^3.9.1",
    "nestjs-form-data": "^1.9.0",
    "nodemailer": "^6.5.0",
    "ofx-js": "^0.2.0",
    "passport": "^0.2.2",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.7",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.20",
    "typeorm-transactional-cls-hooked": "^0.1.20",
