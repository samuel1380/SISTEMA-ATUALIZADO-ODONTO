# ========================================================================
# CONFIGURAÇÃO DE PRODUÇÃO - ODONTOPRINT BACKEND (NESTJS)
# Copie este arquivo para .env no servidor EC2:
# cp .env.production.example .env
# ========================================================================

# Ambiente e Porta
NODE_ENV=production
PORT=3002

# ------------------------------------------------------------------------
# BANCO DE DADOS AWS (RDS / AURORA MYSQL)
# Atenção: Use o Endpoint do RDS/Aurora (Cluster Endpoint ou Instance Endpoint)
# ------------------------------------------------------------------------
DATABASE_HOST=seu-endpoint-rds-ou-aurora.us-east-1.rds.amazonaws.com
DATABASE_PORT=3306
DATABASE_NAME=odontoprint_db
DATABASE_USERNAME=admin
DATABASE_PASSWORD=SUA_SENHA_FORTE_DO_BANCO_AQUI

# ------------------------------------------------------------------------
# SEGURANÇA E AUTENTICAÇÃO JWT
# Chaves secretas usadas para criptografia de senhas e geração de tokens
# ------------------------------------------------------------------------
CHAVE_SECRETA=3e081df3d29c4dacb1f50f0d5bbbf38b
CHAVE_SECRETA_JWT=67f25376b4c1dcfc9b6ad0606566ec4227b731fe59ee0392c60f51dc9c377866

# ------------------------------------------------------------------------
# ARMAZENAMENTO DE ARQUIVOS (AWS S3)
# Usado para uploads de arquivos de trabalho, STL, fotos de pacientes, etc.
# ------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=SUA_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=SUA_AWS_SECRET_ACCESS_KEY
BUCKET_AWS=odontoprintfileserver

# ------------------------------------------------------------------------
# ENVIO DE E-MAILS (AWS SES SMTP)
# Usado para recuperação de senha e notificações
# ------------------------------------------------------------------------
EMAIL_AWS=contato@odontoprint.com.br
EMAIL_USER_AWS=SEU_USUARIO_SMTP_SES
EMAIL_PASSWORD_AWS=SUA_SENHA_SMTP_SES
EMAIL_HOST_AWS=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT_AWS=587
